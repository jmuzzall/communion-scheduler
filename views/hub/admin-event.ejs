<%- include('../partials/head', { title: name + ' ' + event.date }) %>
<%- include('navbar') %>

<div class="container-fluid mt-4 mb-5 px-4">
  <a href="/admin/<%= ministry %>" class="small"><i class="bi bi-arrow-left"></i> <%= name %> schedule</a>
  <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mt-2 mb-3">
    <div>
      <h2 class="mb-1"><%= name %>, <%= display %></h2>
      <p class="text-muted mb-0">
        <%= event.status === 'filled' ? 'Filled. Sign-up is closed; swaps and staff changes still work.' : (open ? `Open for sign-up. Auto-fill runs ${autofillOn}.` : 'Not open for sign-up yet.') %>
      </p>
    </div>
    <div class="d-flex gap-2">
      <a class="btn btn-outline-primary" href="/admin/<%= ministry %>/<%= event.id %>/export.xlsx"><i class="bi bi-file-earmark-excel"></i> Export</a>
      <% if (event.status !== 'filled') { %>
        <form method="POST" action="/admin/<%= ministry %>/<%= event.id %>/autofill" class="d-flex align-items-center gap-2">
          <label class="small"><input type="checkbox" name="notify" class="form-check-input" checked> Email people assigned</label>
          <button class="btn btn-gold"><i class="bi bi-magic"></i> Auto-fill now</button>
        </form>
      <% } %>
    </div>
  </div>

  <% if (success) { %><div class="alert alert-success alert-dismissible fade show"><%= success %><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div><% } %>
  <% if (error) { %><div class="alert alert-danger alert-dismissible fade show"><%= error %><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div><% } %>

  <div class="row g-4">
    <% slots.forEach(slot => { %>
      <div class="col-lg-6 col-xl-4">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-header bg-navy"><strong><%= slot.service_time %></strong> · <%= slot.campus %> <%= slot.area %></div>
          <div class="card-body">
            <p class="mb-2 <%= slot.open ? 'text-danger' : 'text-muted' %>"><%= slot.filled %> of <%= slot.needed %> filled</p>
            <% slot.assigned.forEach(a => { %>
              <div class="slot-badge">
                <%= a.person_name %>
                <span class="badge bg-light text-dark border ms-1" style="font-size:.65rem;"><%= a.type %></span>
                <form method="POST" action="/admin/<%= ministry %>/remove/<%= a.id %>" class="d-inline">
                  <button class="btn btn-link btn-sm text-danger p-0 ms-1" aria-label="Remove <%= a.person_name %>"><i class="bi bi-x-circle"></i></button>
                </form>
              </div>
            <% }) %>
            <% if (slot.open) { %>
              <form method="POST" action="/admin/<%= ministry %>/<%= event.id %>/assign" class="mt-2">
                <input type="hidden" name="position_id" value="<%= slot.id %>">
                <div class="input-group input-group-sm">
                  <label class="visually-hidden" for="add-<%= slot.id %>">Add person</label>
                  <select id="add-<%= slot.id %>" name="person_id" class="form-select form-select-sm" required>
                    <option value="">Add person...</option>
                    <% slot.options.forEach(o => { %><option value="<%= o.id %>"><%= o.name %><%= o.note ? ' (' + o.note + ')' : '' %></option><% }) %>
                  </select>
                  <button class="btn btn-sm btn-gold">Add</button>
                </div>
                <label class="form-check-label small text-muted mt-1">
                  <input type="checkbox" name="allow_conflict" class="form-check-input"> Allow anyway, even if double-booked or away
                </label>
              </form>
            <% } %>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <div class="row g-4 mt-1">
    <div class="col-lg-4">
      <h5>Marked away</h5>
      <% if (!awayPeople.length) { %><p class="small text-muted">Nobody on this roster marked this Sunday away.</p><% } %>
      <ul class="small">
        <% awayPeople.forEach(u => { %><li><%= u.name %><%= u.reason ? ': ' + u.reason : '' %></li><% }) %>
      </ul>
    </div>
    <div class="col-lg-8">
      <h5>Change history</h5>
      <% if (!changes.length) { %><p class="small text-muted">No changes yet.</p><% } %>
      <ul class="small list-unstyled">
        <% changes.forEach(c => { %>
          <li class="mb-1">
            <span class="text-muted"><%= c.created_at %> UTC</span> ·
            <% if (c.action === 'swap') { %>swap: <%= c.info.to %> takes <%= c.info.position %> from <%= c.info.from %>
            <% } else { %><%= c.action.replace('_', ' ') %>: <%= c.info.person %> <%= c.info.position ? '· ' + c.info.position : '' %><% } %>
            <% if (c.info.override) { %><span class="badge bg-warning text-dark">override</span><% } %>
            <% if (c.actor) { %><span class="text-muted">by <%= c.actor %></span><% } %>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
