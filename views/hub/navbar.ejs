<% if (isStaging) { %>
  <div class="text-center small py-1" style="background:#fff3cd;color:#664d03;">Test copy: only testers can sign in, and email goes only to testers.</div>
<% } %>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container-fluid">
    <a class="navbar-brand" href="/me">MPC Officer Service</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#hubNav" aria-label="Menu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="hubNav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link <%= page === 'me' ? 'active' : '' %>" href="/me">My Sundays</a></li>
        <% if (servesIn.includes('communion')) { %>
          <li class="nav-item"><a class="nav-link <%= page === 'communion' ? 'active' : '' %>" href="/communion">Communion</a></li>
        <% } %>
        <li class="nav-item"><a class="nav-link <%= page === 'swaps' ? 'active' : '' %>" href="/swaps">Swaps</a></li>
        <li class="nav-item"><a class="nav-link <%= page === 'profile' ? 'active' : '' %>" href="/me/profile">Profile</a></li>
        <% if (canManageCommunion) { %>
          <li class="nav-item"><a class="nav-link <%= page === 'schedule' ? 'active' : '' %>" href="/admin/communion">Schedule</a></li>
        <% } %>
        <% if (isSuper) { %>
          <li class="nav-item"><a class="nav-link <%= page === 'people' ? 'active' : '' %>" href="/admin/people">People</a></li>
        <% } %>
      </ul>
      <ul class="navbar-nav">
        <li class="nav-item"><span class="nav-link text-light opacity-75"><%= person.name %></span></li>
        <li class="nav-item"><a class="nav-link" href="/signout">Sign out</a></li>
      </ul>
    </div>
  </div>
</nav>
