<%- include('../partials/head', { title: name }) %>
<%- include('navbar') %>

<div class="container mt-4 mb-5">
  <% if (success) { %><div class="alert alert-success alert-dismissible fade show"><%= success %><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div><% } %>
  <% if (error) { %><div class="alert alert-danger alert-dismissible fade show"><%= error %><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div><% } %>

  <h2 class="mb-1"><%= name %></h2>
  <p class="text-muted">Sign-up is open for the next three months. Each Sunday closes when open slots are filled automatically, on the Friday of the week before.</p>

  <% if (!events.length) { %>
    <p class="text-muted">No <%= name.toLowerCase() %> Sundays in the next three months.</p>
  <% } %>
  <div class="list-group shadow-sm">
    <% events.forEach(e => { %>
      <a href="/<%= ministry %>/<%= e.id %>" class="list-group-item list-group-item-action d-flex flex-wrap align-items-center gap-2">
        <strong style="min-width:150px;"><%= e.display %></strong>
        <span class="small text-muted"><%= e.filled %> of <%= e.needed %> filled</span>
        <% if (e.mine.length) { %>
          <span class="badge bg-success">You: <%= e.mine.join('; ') %></span>
        <% } else if (e.away.blocked) { %>
          <span class="badge bg-secondary">You're away</span>
        <% } %>
        <span class="ms-auto badge <%= e.open ? 'bg-light text-dark border' : 'bg-secondary' %>"><%= e.open ? 'Open' : 'Closed' %></span>
      </a>
    <% }) %>
  </div>
</div>

<%- include('../partials/footer') %>
