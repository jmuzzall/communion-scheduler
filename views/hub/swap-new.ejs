<%- include('../partials/head', { title: 'Propose a Swap' }) %>
<%- include('navbar') %>

<div class="container mt-4 mb-5">
  <a href="/me" class="small"><i class="bi bi-arrow-left"></i> My Sundays</a>
  <h2 class="mt-2 mb-1">Propose a swap</h2>
  <p class="text-muted">You're offering <strong><%= ministryName %>, <%= mineDay %>: <%= minePosition %></strong>. Pick a slot to take in exchange. The other person has to accept, and staff are told when they do.</p>

  <% if (!others.length) { %>
    <p class="text-muted">Nobody else has an upcoming <%= ministryName.toLowerCase() %> assignment to swap with yet.</p>
  <% } %>
  <div class="list-group shadow-sm">
    <% others.forEach(o => { %>
      <div class="list-group-item <%= o.blockReason ? 'slot-excluded' : '' %>">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
          <div>
            <strong><%= o.display %></strong> · <%= o.position %>
            <div class="small text-muted"><%= o.person_name %></div>
            <% if (o.blockReason) { %><div class="small text-danger"><i class="bi bi-slash-circle"></i> Not available: <%= o.blockReason %></div><% } %>
          </div>
          <% if (!o.blockReason) { %>
            <form method="POST" action="/swaps/propose" class="d-flex gap-2 align-items-center">
              <input type="hidden" name="my_assignment_id" value="<%= mine.id %>">
              <input type="hidden" name="their_assignment_id" value="<%= o.id %>">
              <label class="visually-hidden" for="msg-<%= o.id %>">Message (optional)</label>
              <input id="msg-<%= o.id %>" type="text" name="message" class="form-control form-control-sm" placeholder="Message (optional)" maxlength="300" style="max-width:220px;">
              <button class="btn btn-sm btn-gold text-nowrap">Propose swap</button>
            </form>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<%- include('../partials/footer') %>
