<%- include('../partials/head', { title: 'My History' }) %>
<%- include('../partials/member-navbar', { page: 'history' }) %>

<div class="container mt-4">
  <h2 class="mb-4">Service History <small class="text-muted fs-6">(past 12 months)</small></h2>

  <% if (history.length > 0) { %>
    <div class="card border-0 shadow-sm">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead>
              <tr><th>Date</th><th>Service</th><th>Location</th><th>Type</th></tr>
            </thead>
            <tbody>
              <% history.forEach(h => { %>
              <tr>
                <td><%= formatDate(h.communion_date) %></td>
                <td><%= h.service_time %></td>
                <td><%= h.location %><%= h.area ? ' (' + h.area + ')' : '' %></td>
                <td><span class="badge badge-<%= h.assignment_type %>"><%= h.assignment_type %></span></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <p class="text-muted mt-3">Total: <strong><%= history.length %></strong> time(s) served</p>
  <% } else { %>
    <div class="text-center py-5 text-muted">
      <i class="bi bi-clock-history" style="font-size:3rem;"></i>
      <p class="mt-2">No service history in the past 12 months.</p>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
