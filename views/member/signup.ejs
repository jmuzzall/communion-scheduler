<%- include('../partials/head', { title: 'Sign Up' }) %>
<%- include('../partials/member-navbar', { page: 'portal' }) %>

<%
  const hasFullDay = existingExclusions.some(e => e.exclusion_type === 'full_day');
  let lastCampus = '';
%>

<div class="container mt-4">
  <% if (success) { %><div class="alert alert-success alert-dismissible fade show"><%= success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (error) { %><div class="alert alert-danger alert-dismissible fade show"><%= error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <h2 class="mb-1">Communion Signup</h2>
  <p class="text-muted mb-4"><%= formatDate(cd.date) %></p>

  <% if (existingAssignments.length > 0) { %>
    <div class="alert alert-info">
      <i class="bi bi-check-circle"></i> You are signed up for <strong><%= existingAssignments.length %></strong> slot<%= existingAssignments.length > 1 ? 's' : '' %>:
      <% existingAssignments.forEach(a => { %>
        <div class="d-flex align-items-center mt-1">
          <span><%= a.service_time %> — <%= a.location %><%= a.area ? ' (' + a.area + ')' : '' %></span>
          <% if (a.assignment_type === 'voluntary') { %>
            <form method="POST" action="/member/signup/<%= cd.id %>/withdraw/<%= a.id %>" class="d-inline ms-2">
              <button class="btn btn-sm btn-outline-danger">Withdraw</button>
            </form>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } %>

  <div class="row g-4">
    <div class="col-lg-8">
      <h5>Available Slots</h5>
      <% slots.forEach(slot => { %>
        <% const campus = slot.location.split(' ')[0]; %>
        <% if (campus !== lastCampus) { lastCampus = campus; %>
          <h6 class="mt-3 mb-2 text-muted">
            <i class="bi bi-geo-alt"></i> <%= campus %> Campus
            <% if (preferredLocation && campus === preferredLocation) { %>
              <span class="badge bg-success ms-1" style="font-size:0.65rem;">Your preferred</span>
            <% } %>
          </h6>
        <% } %>
        <% const isExcluded = hasFullDay; %>
        <% const isBlocked = !assignedSlotIds.has(slot.id) && !isExcluded && slot.conflict; %>
        <div class="card border-0 shadow-sm mb-3 <%= isExcluded || isBlocked ? 'slot-excluded' : '' %>">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="mb-0"><%= slot.service_time %> — <%= slot.location %><%= slot.area ? ' (' + slot.area + ')' : '' %></h6>
                <small class="text-muted"><%= slot.filled %> / <%= slot.servers_needed %> filled</small>
              </div>
              <% if (assignedSlotIds.has(slot.id)) { %>
                <span class="badge bg-success">Signed Up</span>
              <% } else if (isExcluded) { %>
                <span class="badge bg-secondary">Excluded</span>
              <% } else if (isBlocked) { %>
                <span class="badge bg-secondary text-wrap text-end" style="max-width:220px;" title="You can only serve one role at a time">Serving at <%= slot.conflict %></span>
              <% } else if (slot.available > 0) { %>
                <form method="POST" action="/member/signup/<%= cd.id %>/claim">
                  <input type="hidden" name="slot_config_id" value="<%= slot.id %>">
                  <button class="btn btn-sm btn-gold">Sign Up</button>
                </form>
              <% } else { %>
                <span class="badge bg-secondary">Full</span>
              <% } %>
            </div>
            <% if (slot.assigned.length > 0) { %>
              <div class="mt-2">
                <% slot.assigned.forEach(a => { %>
                  <span class="slot-badge"><%= a.name %></span>
                <% }) %>
              </div>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>

    <div class="col-lg-4">
      <h5>Availability</h5>
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <% if (hasFullDay) { %>
            <% const fullDayEx = existingExclusions.find(e => e.exclusion_type === 'full_day'); %>
            <div class="d-flex justify-content-between align-items-center mb-2">
              <div class="small">
                <i class="bi bi-x-circle text-danger"></i> Unavailable all day
                <% if (fullDayEx.reason) { %>
                  <span class="text-muted d-block ms-4"><%= fullDayEx.reason %></span>
                <% } %>
              </div>
              <form method="POST" action="/member/signup/<%= cd.id %>/remove-exclusion/<%= fullDayEx.id %>">
                <button class="btn btn-sm btn-link text-danger p-0"><i class="bi bi-trash"></i></button>
              </form>
            </div>
          <% } else { %>
            <p class="text-muted small">Can't make it this Sunday?</p>
            <button class="btn btn-sm btn-outline-danger w-100" data-bs-toggle="modal" data-bs-target="#unavailableModal">Unavailable All Day</button>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="unavailableModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/member/signup/<%= cd.id %>/exclude">
        <input type="hidden" name="exclusion_type" value="full_day">
        <div class="modal-header">
          <h5 class="modal-title">Mark Unavailable</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p>You will be marked as unavailable for all services on <strong><%= formatDate(cd.date) %></strong>.</p>
          <div class="mb-2">
            <label class="form-label">Reason (optional)</label>
            <textarea name="reason" class="form-control" rows="2" maxlength="200" placeholder="e.g., Out of town, family commitment"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-outline-danger">Mark Unavailable</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
