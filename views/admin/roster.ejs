<%- include('../partials/head', { title: 'Roster' }) %>
<%- include('../partials/admin-navbar', { page: 'roster' }) %>

<div class="container mt-4">
  <% if (success) { %><div class="alert alert-success alert-dismissible fade show"><%= success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (error) { %><div class="alert alert-danger alert-dismissible fade show"><%= error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Member Roster</h2>
    <div class="d-flex gap-2">
      <button class="btn btn-gold" data-bs-toggle="modal" data-bs-target="#addModal"><i class="bi bi-plus-lg"></i> Add Member</button>
      <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#importModal"><i class="bi bi-upload"></i> Import CSV</button>
      <form method="POST" action="/admin/roster/send-magic-links-all" class="d-inline" onsubmit="return confirm('Send a magic login link to all members on the roster?')">
        <button class="btn btn-outline-primary"><i class="bi bi-link-45deg"></i> Send Login Links to All</button>
      </form>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead>
            <tr><th>Name</th><th>Email</th><th>Phone</th><th>Category</th><th>Notifications</th><th>Actions</th></tr>
          </thead>
          <tbody>
            <% members.forEach(m => { %>
            <tr>
              <td><strong><%= m.name %></strong></td>
              <td><%= m.email %></td>
              <td><%= m.phone || '—' %></td>
              <td><span class="badge" style="background:var(--mp-navy);"><%= formatCategory(m.category) %></span></td>
              <td>
                <% if (m.notify_email) { %><i class="bi bi-envelope-fill text-muted" title="Email"></i> <% } %>
                <% if (m.notify_sms) { %><i class="bi bi-phone-fill text-muted" title="SMS"></i> <% } %>
              </td>
              <td>
                <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editModal<%= m.id %>" title="Edit"><i class="bi bi-pencil"></i></button>
                <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#pwModal<%= m.id %>" title="Set password"><i class="bi bi-key"></i></button>
                <form method="POST" action="/admin/roster/send-magic-link/<%= m.id %>" class="d-inline">
                  <button class="btn btn-sm btn-outline-primary" title="Send login link"><i class="bi bi-link-45deg"></i></button>
                </form>
                <form method="POST" action="/admin/roster/delete/<%= m.id %>" class="d-inline">
                  <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Remove this member?')" title="Delete"><i class="bi bi-trash"></i></button>
                </form>
              </td>
            </tr>

            <div class="modal fade" id="editModal<%= m.id %>" tabindex="-1">
              <div class="modal-dialog">
                <div class="modal-content">
                  <form method="POST" action="/admin/roster/edit/<%= m.id %>">
                    <div class="modal-header"><h5 class="modal-title">Edit Member</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                    <div class="modal-body">
                      <div class="mb-3"><label class="form-label">Name</label><input type="text" name="name" class="form-control" value="<%= m.name %>" required></div>
                      <div class="mb-3"><label class="form-label">Email</label><input type="email" name="email" class="form-control" value="<%= m.email %>" required></div>
                      <div class="mb-3"><label class="form-label">Phone</label><input type="text" name="phone" class="form-control" value="<%= m.phone || '' %>"></div>
                      <div class="mb-3">
                        <label class="form-label">Category</label>
                        <select name="category" class="form-select">
                          <option value="active_elder" <%= m.category === 'active_elder' ? 'selected' : '' %>>Active Elder</option>
                          <option value="active_deacon" <%= m.category === 'active_deacon' ? 'selected' : '' %>>Active Deacon</option>
                          <option value="inactive_elder" <%= m.category === 'inactive_elder' ? 'selected' : '' %>>Inactive Elder</option>
                          <option value="inactive_deacon" <%= m.category === 'inactive_deacon' ? 'selected' : '' %>>Inactive Deacon</option>
                        </select>
                      </div>
                    </div>
                    <div class="modal-footer"><button type="submit" class="btn btn-gold">Save</button></div>
                  </form>
                </div>
              </div>
            </div>

            <div class="modal fade" id="pwModal<%= m.id %>" tabindex="-1">
              <div class="modal-dialog modal-sm">
                <div class="modal-content">
                  <form method="POST" action="/admin/roster/set-password/<%= m.id %>" onsubmit="if(this.password.value!==this.password_confirm.value){alert('Passwords do not match');return false;}">
                    <div class="modal-header"><h5 class="modal-title">Set Password</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                    <div class="modal-body">
                      <p class="text-muted small mb-2">Set a password for <strong><%= m.name %></strong></p>
                      <div class="mb-2"><input type="password" name="password" class="form-control" placeholder="New password" required minlength="8"></div>
                      <div class="mb-2"><input type="password" name="password_confirm" class="form-control" placeholder="Confirm password" required minlength="8"></div>
                      <div class="form-text">Min 8 chars, with uppercase, lowercase, and a number.</div>
                    </div>
                    <div class="modal-footer"><button type="submit" class="btn btn-gold">Set Password</button></div>
                  </form>
                </div>
              </div>
            </div>
            <% }) %>
            <% if (members.length === 0) { %>
            <tr><td colspan="6" class="text-muted text-center py-3">No members yet. Add members or import a CSV.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="addModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/admin/roster/add">
        <div class="modal-header"><h5 class="modal-title">Add Member</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
          <div class="mb-3"><label class="form-label">Name</label><input type="text" name="name" class="form-control" required></div>
          <div class="mb-3"><label class="form-label">Email</label><input type="email" name="email" class="form-control" required></div>
          <div class="mb-3"><label class="form-label">Phone</label><input type="text" name="phone" class="form-control"></div>
          <div class="mb-3">
            <label class="form-label">Category</label>
            <select name="category" class="form-select">
              <option value="active_elder">Active Elder</option>
              <option value="active_deacon">Active Deacon</option>
              <option value="inactive_elder">Inactive Elder</option>
              <option value="inactive_deacon">Inactive Deacon</option>
            </select>
          </div>
        </div>
        <div class="modal-footer"><button type="submit" class="btn btn-gold">Add Member</button></div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="importModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/admin/roster/import" enctype="multipart/form-data">
        <div class="modal-header"><h5 class="modal-title">Import CSV</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
          <p class="text-muted">Upload a CSV with columns: <code>name, email, phone, category</code></p>
          <p class="text-muted small">Category values: active_elder, active_deacon, inactive_elder, inactive_deacon</p>
          <input type="file" name="csv" class="form-control" accept=".csv" required>
        </div>
        <div class="modal-footer"><button type="submit" class="btn btn-gold">Import</button></div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
