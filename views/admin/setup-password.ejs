<%- include('../partials/head', { title: 'Set Up Admin Account' }) %>

<div class="d-flex align-items-center justify-content-center min-vh-100" style="background:var(--mp-cream);">
  <div class="card home-card p-4" style="max-width:460px;width:100%;">
    <div class="text-center mb-3">
      <i class="bi bi-shield-lock" style="font-size:2.5rem;color:var(--mp-navy);"></i>
      <h3 class="home-card-title mt-2">Set Up Admin Account</h3>
    </div>
    <p class="text-muted">Welcome, <strong><%= adminName %></strong>! Create a password for your administrator account.</p>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>
    <% if (errors.length > 0) { %>
      <div class="alert alert-danger">
        <strong>Password does not meet requirements:</strong>
        <ul class="mb-0 mt-1">
          <% errors.forEach(e => { %><li><%= e %></li><% }) %>
        </ul>
      </div>
    <% } %>

    <div class="alert alert-light border mb-3">
      <strong class="d-block mb-1"><i class="bi bi-info-circle"></i> Password Requirements</strong>
      <ul class="mb-0 small" style="padding-left:1.2rem;">
        <li>At least 8 characters long</li>
        <li>At least one uppercase letter (A-Z)</li>
        <li>At least one lowercase letter (a-z)</li>
        <li>At least one number (0-9)</li>
      </ul>
      <p class="mb-0 mt-2 small text-muted"><strong>Tip:</strong> Use a memorable phrase like <em>Admin2026Mpc</em></p>
    </div>

    <form method="POST" action="/admin/setup/<%= token %>">
      <div class="mb-3">
        <label class="form-label fw-500">Password</label>
        <input type="password" name="password" class="form-control" required minlength="8" autofocus>
      </div>
      <div class="mb-3">
        <label class="form-label fw-500">Confirm Password</label>
        <input type="password" name="password_confirm" class="form-control" required minlength="8">
      </div>
      <button type="submit" class="btn btn-gold w-100">Set Password & Log In</button>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
