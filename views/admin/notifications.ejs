<%- include('../partials/head', { title: 'Notification Log' }) %>
<%- include('../partials/admin-navbar', { page: 'notifications' }) %>

<div class="container mt-4">
  <h2 class="mb-4">Notification Log</h2>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead>
            <tr><th>Date Sent</th><th>Member</th><th>Type</th><th>Channel</th><th>Status</th></tr>
          </thead>
          <tbody>
            <% logs.forEach(l => { %>
            <tr>
              <td><%= l.sent_at %></td>
              <td><%= l.name || '—' %></td>
              <td><code><%= l.notification_type %></code></td>
              <td><i class="bi bi-<%= l.channel === 'email' ? 'envelope' : 'phone' %>"></i> <%= l.channel %></td>
              <td>
                <span class="badge bg-<%= l.status === 'sent' ? 'success' : l.status === 'failed' ? 'danger' : 'warning' %>"><%= l.status %></span>
                <% if (l.error_message) { %><small class="text-danger d-block"><%= l.error_message %></small><% } %>
              </td>
            </tr>
            <% }) %>
            <% if (logs.length === 0) { %>
            <tr><td colspan="5" class="text-muted text-center py-3">No notifications sent yet.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
